rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role(name) {
      return signedIn() && request.auth.token.get('roles', []).hasAny([name])
        && firestore.exists(/databases/(default)/documents/staffAssignments/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staffAssignments/$(request.auth.uid)).data.roles.hasAny([name]);
    }
    function editor() { return role('super_admin') || role('admin') || role('content_editor'); }
    function validImage() {
      return request.resource != null && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /avatars/{uid}/{filename} {
      allow read: if signedIn() && (request.auth.uid == uid || editor());
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Upload to gallery only after editorial consent. Public photos are intended
    // for publication; private albums should use a separate path and callable.
    match /gallery/{albumId}/{filename} {
      allow read: if true;
      allow create, update: if editor() && validImage();
      allow delete: if editor();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
